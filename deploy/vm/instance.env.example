# Settings for create_instance.py. Copy to instance.env (gitignored) and fill in your own values
# (DEPLOYMENT.md, section 2, "Option A", says where to find each one).
# Environment variables of the same names take precedence over this file.

# Where the instance goes. For the root compartment, this is your tenancy OCID.
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1...
# The VCN's public subnet (not the private one).
OCI_SUBNET_ID=ocid1.subnet.oc1...
# Your SSH public key (the .pub file, never the private key).
SSH_PUBLIC_KEY_FILE=~/.ssh/oracle_vm.pub

# Optional. Default: the newest Canonical Ubuntu 24.04 aarch64 image (not "Minimal").
OCI_IMAGE_ID=
# Optional, comma-separated. Default: all of the region's availability domains, tried in turn.
OCI_AVAILABILITY_DOMAINS=
# Optional. Default: brain-tumour-api
INSTANCE_NAME=brain-tumour-api
