# The VM's .env, in the bundle folder: setup_remote.py writes it, or copy and fill in (DEPLOYMENT.md, section 6).
# The API's public host name: the DuckDNS subdomain pointing at the VM.
DOMAIN=brain-tumour-api.duckdns.org
# The web client's address, allowed to call the API: https://, no trailing slash.
ALLOWED_ORIGIN=https://brain-tumour-detector.vercel.app
