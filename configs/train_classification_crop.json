{
  "batch_size": 16,
  "grad_accum_steps": 1,
  "mixed_precision": true,
  "seed": 42,
  "epochs": 30,
  "weight_decay": 0.01,
  "num_workers": 6,
  "max_step_seconds": 3.0,
  "slow_step_patience": 5,
  "wandb_project": "brain-tumor-classification",
  "image_size": 384,
  "pretrained": true,
  "freeze_backbone": false,
  "backbone_lr": 0.0001,
  "head_lr": 0.001,
  "warmup_epochs": 1,
  "min_lr_ratio": 0.01,
  "patience": 5,
  "augment": true,
  "random_crop": true,
  "crop_scale": [0.7, 1.0],
  "crop_ratio": [0.75, 1.3333],
  "misclassified_every": 2,
  "misclassified_max": 24,
  "checkpoint_dir": "models/classification_crop"
}
